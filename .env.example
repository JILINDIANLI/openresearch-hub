APP_NAME=OpenResearch Hub API
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./data/openresearch.db
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=openresearch-resources
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MAX_UPLOAD_SIZE=209715200
COMMUNITY_CACHE_TTL=120
DISCUSSION_RATE_LIMIT=5
ISSUE_RATE_LIMIT=5
COMMENT_RATE_LIMIT=10
COMMUNITY_RATE_LIMIT_WINDOW_SECONDS=60
GITEA_URL=http://127.0.0.1:3000
GITEA_API_URL=http://gitea:3000/api/v1
GITEA_TOKEN=replace-with-a-gitea-service-token
GITEA_DEFAULT_OWNER=openresearch
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_TIMEOUT=8
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
