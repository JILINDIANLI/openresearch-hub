APP_ENV=production
APP_NAME=OpenResearch Hub API
APP_VERSION=1.0.0
BACKUP_DIR=./backup/private
APP_DOMAIN=research.example.com
APP_BASE_URL=https://research.example.com
GITEA_DOMAIN=git.example.com
SECRET_KEY=replace-with-unique-random-value-at-least-32-characters
JWT_SECRET=replace-with-another-unique-random-value-at-least-32-characters
DATABASE_URL=postgresql+psycopg2://openresearch:replace-me@postgres:5432/openresearch
POSTGRES_DB=openresearch
POSTGRES_USER=openresearch
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-another-long-random-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=storage.example.com
MINIO_ACCESS_KEY=replace-with-unique-minio-user
MINIO_SECRET_KEY=replace-with-long-random-minio-secret
MINIO_BUCKET=openresearch-resources
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=true
GITEA_TOKEN=replace-with-gitea-service-token
GITEA_DEFAULT_OWNER=openresearch
GITEA_URL=https://git.example.com
GITEA_API_URL=http://gitea:3000/api/v1
GITEA_INTERNAL_URL=http://gitea:3000
GITEA_SSH_PORT=2222
BACKEND_IMAGE=openresearch-backend:2026-09-24
CORS_ORIGINS=https://research.example.com
TRUSTED_HOSTS=research.example.com,git.example.com,storage.example.com
MAX_UPLOAD_SIZE=209715200
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
CERTBOT_EMAIL=ops@example.com
ALLOW_PUBLIC_REGISTRATION=true
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_KEY=
LOGIN_RATE_LIMIT=8
REGISTER_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=12
SEARCH_SUGGESTIONS_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW_SECONDS=60
